modules = ["python-base-3.13"]

[deployment]
run = ["python", "main.py"]
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hello Flask App"

[[workflows.workflow]]
name = "Hello Flask App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./.pythonlibs/bin/python main.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80
